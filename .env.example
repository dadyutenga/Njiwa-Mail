# Copy to .env (never commit .env). Generate secrets with:
#   openssl rand -base64 32     # ENCRYPTION_KEY (exactly 32 bytes decoded)
#   openssl rand -base64 48     # HMAC_KEY (>= 32 bytes decoded)
# BACK UP ENCRYPTION_KEY and HMAC_KEY: losing them makes queued payloads
# unreadable and breaks idempotency comparison for in-flight messages.

POSTGRES_PASSWORD=change-me
# For non-compose runs set DATABASE_URL directly (use sslmode=verify-full off-box):
# DATABASE_URL=postgres://mail:PASSWORD@db-host:5432/mail?sslmode=verify-full
ENCRYPTION_KEY=
HMAC_KEY=
# Alternatively mount secrets and use ENCRYPTION_KEY_FILE / HMAC_KEY_FILE / SMTP_PASSWORD_FILE / DATABASE_URL_FILE.

# Mailcow submission (leave SMTP_HOST empty => sandbox only; live messages stay queued then expire)
SMTP_HOST=
# SMTP_FAILOVER_HOST=                     # tried only when the first host fails before acceptance
SMTP_PORT=587
SMTP_TLS_MODE=starttls          # starttls (587) or implicit (465). Plaintext is not supported.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HELO_NAME=mail.example.com  # should match the sending host's reverse DNS
SMTP_TIMEOUT=40s

# Limits / retention (defaults shown)
# MAX_BODY_BYTES=32768
# METADATA_RETENTION=720h         # 30 days
# CAPTURE_RETENTION=24h           # sandbox captured content
# UNKNOWN_PAYLOAD_PURGE=24h       # must not exceed 24h
# MAX_ATTEMPTS=4
# LEASE_DURATION=90s              # must exceed SMTP_TIMEOUT
# WORKER_POLL_INTERVAL=500ms
# RETENTION_INTERVAL=10m
# LOG_LEVEL=info

# ---- v2 --------------------------------------------------------------------
# Bounce address: used as the SMTP envelope sender (MAIL FROM) so DSNs come back
# to the inbound listener. The Mailcow submission mailbox must be allowed to
# send as this address AND as every approved sender address.
# BOUNCE_ADDRESS=bounces@notify.example.com

# Inbound mail (role: inbound). See docs/MAILCOW_SETUP.md.
# INBOUND_DOMAIN=in.example.com
# INBOUND_ALLOWED_SOURCES=172.22.1.253     # Mailcow postfix container address(es); everyone else is refused
# INBOUND_IPV4=172.22.1.200                # fixed address of the listener on Mailcow's Docker network (compose only)
# MAILCOW_NETWORK=mailcowdockerized_mailcow-network
# INBOUND_MAX_BYTES=10485760               # 10 MiB per message
# IMAP_HOST=                               # catch-all mailbox, used when Mailcow cannot relay
# IMAP_PORT=993
# IMAP_USERNAME=
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# DATA_DIR=/var/lib/njiwa-mail         # spool + attachments (set by compose; shared by api, inbound, scheduler)

# DNS health checker (read-only): what the records are expected to point at.
# MAIL_HOSTNAME=mail.example.com           # Mailcow hostname: MX target and PTR value
# OUTBOUND_IP=203.0.113.10                 # IP Mailcow sends from
# DKIM_SELECTOR=dkim                       # selector shown in Mailcow for the sending domain

# Sending-domain gate. Live mail and Live senders need a domain that this
# project registered, verified and holds the installation-wide claim for.
# Temporary upgrade escape hatch ONLY: lets Live mail use domains that no
# project has registered or claimed. Register your domains, then remove it.
# ALLOW_UNREGISTERED_LIVE_DOMAINS=false

# Installation-wide limits on accepted Live messages, on top of each project's
# quotas. They protect the server's reputation from one compromised key or a
# flood across projects. 0 turns a limit off.
# LIVE_GLOBAL_PER_MINUTE=600
# LIVE_GLOBAL_PER_HOUR=20000
# LIVE_DOMAIN_PER_MINUTE=300
# LIVE_DOMAIN_PER_HOUR=10000
# Bound on the Live backlog (queued, retrying, sending, scheduled). When the
# mail server is down long enough to fill it, new Live mail gets a retryable
# 503 queue_full instead of growing the queue without limit. 0 = no bound.
# LIVE_QUEUE_MAX=50000

# Admin API (/admin/v1). Users are created with: njiwa-mail user create -email E -role owner
# ADMIN_SESSION_TTL=12h
# TRUST_PROXY=true                         # behind deploy/nginx.conf: client IP comes from X-Forwarded-For
# ADMIN_INSECURE_COOKIES=false             # true ONLY for local development over plain HTTP
# PUBLIC_URL=https://mail.example.com      # used in admin password-reset links
# INGRESS_ADDR=                            # reserved; applications send with HTTPS /v1
# METRICS_TOKEN=                           # >= 16 chars enables GET /metrics (Authorization: Bearer <token>)

# Legacy read-only operator console (frontend). Leave empty to disable /console.
# This password is not a project API key. Never put project keys in the browser.
# CONSOLE_PASSWORD=
# CONSOLE_SESSION_TTL=12h
