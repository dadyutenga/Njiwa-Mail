# Alternative to compose: supervised native SMTP relay for applications.
# Set RELAY_LISTEN_ADDR, RELAY_TLS_CERT and RELAY_TLS_KEY in the env file.
[Unit]
Description=Njiwa Mail SMTP relay
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=njiwa-mail
EnvironmentFile=/etc/njiwa-mail/env
ExecStart=/usr/local/bin/njiwa-mail relay
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Port 587 needs this capability as a non-root user; use a port above 1024 to drop it.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
