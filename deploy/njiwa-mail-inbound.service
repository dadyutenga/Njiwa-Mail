# Alternative to compose: supervised native inbound (adjust paths / env file).
[Unit]
Description=Njiwa Mail inbound
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=njiwa-mail
EnvironmentFile=/etc/njiwa-mail/env
ExecStart=/usr/local/bin/njiwa-mail inbound
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# DATA_DIR (spool and attachments) must be writable and shared with the API unit.
ReadWritePaths=/var/lib/njiwa-mail

[Install]
WantedBy=multi-user.target
