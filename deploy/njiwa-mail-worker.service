# Alternative to compose: supervised native worker (adjust paths / env file).
[Unit]
Description=Njiwa Mail worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=njiwa-mail
EnvironmentFile=/etc/njiwa-mail/env
ExecStart=/usr/local/bin/njiwa-mail worker
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
