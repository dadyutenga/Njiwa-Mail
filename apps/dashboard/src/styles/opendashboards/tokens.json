{
  "name": "OpenDashboards",
  "source": {
    "dashboard": "@openuidev/dashboard-library defaultLightTheme / defaultDarkTheme",
    "app": "app/globals.css",
    "marketing": "components/landing/bevel-button.tsx and app/(marketing)/layout.tsx"
  },
  "font": {
    "sans": "Inter",
    "display": "Inter Display",
    "wordmark": "Geist",
    "mono": "Geist Mono"
  },
  "type": {
    "page": { "size": "1.75rem", "weight": 700, "leading": 1.2, "tracking": "-0.02em" },
    "section": { "size": "15px", "weight": 600, "tracking": "-0.005em" },
    "card": { "size": "14px", "weight": 600, "leading": 1.35 },
    "kpi": { "size": "26px", "weight": 600, "leading": 1.1 },
    "body": { "size": "13px", "weight": 500, "leading": 1.45 },
    "caption": { "size": "12px", "leading": 1.4 },
    "display": { "size": "clamp(1.75rem, 3vw, 2.5rem)", "weight": 600, "leading": 1.1, "tracking": "-0.02em" }
  },
  "dashboard": {
    "light": {
      "page": "#ffffff",
      "surface": "#ffffff",
      "surfaceSubtle": "rgba(0, 0, 0, 0.04)",
      "border": "rgba(0, 0, 0, 0.06)",
      "borderStrong": "rgba(0, 0, 0, 0.1)",
      "ink": "#0d0d0d",
      "inkSecondary": "rgba(13, 13, 13, 0.64)",
      "inkMuted": "rgba(13, 13, 13, 0.52)",
      "grid": "#f1f1f1",
      "accent": "#0e0e0e",
      "accentInk": "#ffffff",
      "series": ["#6155e8", "#16b76f", "#ffc700", "#df507b", "#3894ff", "#ff8000", "#a0522d", "#00cbd9"],
      "sequential": ["#f5f6ff", "#d9ddff", "#c0c5f9", "#a7acf1", "#9094e8", "#797cdd", "#6563d2", "#5248c6", "#4229ba"],
      "diverging": ["#b32f5b", "#ca647e", "#dd92a2", "#eebfc9", "#e7e7e7", "#c6caf2", "#9fa4e5", "#7b7ed7", "#5a56c7"],
      "good": "#079455",
      "goodMark": "#16b76f",
      "bad": "#c82c37",
      "badMark": "#d03348",
      "warning": "#cd8200",
      "warningMark": "#ffc700",
      "info": "#317ce6",
      "mapLand": "#efefef",
      "radius": "16px",
      "radiusMd": "12px",
      "radiusSm": "8px",
      "space": ["8px", "12px", "16px", "20px", "24px", "36px"],
      "shadow": "0 3px 8px -3px rgba(0, 0, 0, 0.04), 0 1px 2px -2px rgba(0, 0, 0, 0.02)"
    },
    "dark": {
      "page": "#141414",
      "surface": "#151515",
      "ink": "#fafafa",
      "series": ["#7b72f2", "#16b76f", "#ffc700", "#df507b", "#3894ff", "#ff8000", "#b8693a", "#00cbd9"],
      "good": "#7fe0b1",
      "bad": "#f1838c",
      "warning": "#ffd84d",
      "info": "#8fbcf7",
      "mapLand": "#232323"
    }
  },
  "app": {
    "radius": "0.625rem",
    "light": {
      "background": "oklch(1 0 0)",
      "foreground": "oklch(0.145 0 0)",
      "primary": "oklch(0.205 0 0)",
      "mutedForeground": "oklch(0.556 0 0)",
      "border": "oklch(0.922 0 0)",
      "destructive": "oklch(0.577 0.245 27.325)",
      "chart": ["oklch(0.87 0 0)", "oklch(0.556 0 0)", "oklch(0.439 0 0)", "oklch(0.371 0 0)", "oklch(0.269 0 0)"]
    }
  },
  "marketing": {
    "page": "#ffffff",
    "ink": "#0a0a0a",
    "muted": "rgb(10 10 10 / 0.6)",
    "secondary": "#f7f7f8",
    "buttonHeight": "48px",
    "buttonRadius": "999px"
  }
}
