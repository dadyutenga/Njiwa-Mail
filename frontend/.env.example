# Frontend Template Environment Configuration
# Copy this file to .env.local to customize locally.
# NOTE: All VITE_* variables are exposed to the browser client bundle. Never store secret keys here.

# API Base URL (leave blank to run in mock/local-only mode)
VITE_API_BASE_URL=https://api.example.com

# Application Brand Name
VITE_APP_TITLE="Your App"
