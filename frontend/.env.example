# Frontend Application Template Environment Configuration
# Copy this file to .env or .env.local to customize your environment

# Application Metadata
VITE_APP_TITLE=Ditronics Mail
VITE_APP_ENV=development

# Operator UI. Vite proxies /admin to the API on 127.0.0.1:8080.
# Sign-in is an operator account (ditronics-mail user create). Do not put a project API key here.
# Local HTTP needs ADMIN_INSECURE_COOKIES=true on the API or the session cookie is dropped.
VITE_API_BASE_URL=/admin/v1

# Feature Flags
VITE_ENABLE_MOCK_AUTH=false
