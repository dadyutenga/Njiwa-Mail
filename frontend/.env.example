# Frontend Application Template Environment Configuration
# Copy this file to .env or .env.local to customize your environment

# Application Metadata
VITE_APP_TITLE=Ditronics Mail
VITE_APP_ENV=development

# Operator console. Vite proxies /console to the API on 127.0.0.1:8080.
# Do not put a project API key here. Sign-in uses CONSOLE_PASSWORD on the server.
VITE_API_BASE_URL=/console

# Feature Flags
VITE_ENABLE_MOCK_AUTH=false
