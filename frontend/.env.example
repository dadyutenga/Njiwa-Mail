# Public frontend configuration only. Do not put API keys or session secrets here.
# Operator API requests use the same origin at /admin/v1. Vite and Nginx proxy them to the backend.
# Set either URL to an empty string to hide its link on the welcome page.
VITE_GITHUB_URL=https://github.com/dadyutenga/Njiwa-Mail
# Origin of your public documentation site (documentation/, deployed per docs/public-portal/DEPLOY.md).
# Leave empty until you publish one; the dashboard then shows no documentation link.
VITE_DOCS_URL=
